# ── MYTHBOUND runtime / save data ──────────────────────────────
# The server regenerates these on the fly. They hold player data and
# churn every session, so tracking them leaks data + causes merge
# conflicts when you switch between your PC and SteamDeck.
.mythbound_accounts.json
_mythbound_accounts.json
.mythbound_queues.json
_mythbound_queues.json
mythbound_ah.json

# ── dependencies (none today; future-proofing) ─────────────────
node_modules/

# ── OS / editor junk ───────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
.vscode/
*.log

# NOTE: do NOT ignore start-mythbound.* — keep the launchers tracked
# so they sync to both machines.
